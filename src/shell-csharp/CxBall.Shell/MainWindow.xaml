<Window x:Class="CxBall.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="学习通悬浮球" Width="400" Height="640"
        MinWidth="340" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="#F1F5F9">
    <!-- 自绘标题栏（§4.5）：CaptionHeight=0 → 系统不把它当标题栏，
         因此拖动不会触发 Aero Snap；也没有系统最大化按钮 → 不会弹出贴靠布局菜单。
         缩放仍可用：ResizeBorderThickness 提供四周可拖拽的边框；CornerRadius 让窗口四角圆角（§8.2.6）。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Background="#FFFFFF"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_Down"
                MouseMove="TitleBar_Move"
                MouseLeftButtonUp="TitleBar_Up">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="学习通悬浮球" FontSize="12" Foreground="#475569"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <!-- 用 PreviewMouseLeftButtonDown：标题栏在 MouseLeftButtonDown 阶段会 CaptureMouse，
                         若走 MouseLeftButtonUp，松手事件只送到标题栏，按钮就会「时灵时不灵」 -->
                    <Border x:Name="BtnMin" Width="34" Height="24" CornerRadius="4"
                            Cursor="Hand"
                            PreviewMouseLeftButtonDown="Minimize_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="—" FontSize="12" Foreground="#475569"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="BtnClose" Width="34" Height="24" CornerRadius="4"
                            Cursor="Hand" Margin="2,0,0,0"
                            PreviewMouseLeftButtonDown="Close_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="✕" FontSize="11" Foreground="#475569"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Web"/>
        </Grid>
    </Grid>
</Window>
