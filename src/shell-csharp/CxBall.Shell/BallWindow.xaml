<Window x:Class="CxBall.Shell.BallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="64" Height="64"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Title="学习通悬浮球">
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="显示主面板" Click="ShowMain"/>
                <Separator/>
                <MenuItem Header="刷新" Click="MenuRefresh"/>
                <MenuItem Header="设置" Click="MenuSettings"/>
                <MenuItem Header="退出登录" Click="MenuLogout"/>
                <Separator/>
                <MenuItem Header="退出程序" Click="QuitApp"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <Ellipse x:Name="Ball" Fill="#FF3B82F6" Cursor="Hand"
                 MouseLeftButtonDown="OnDown" MouseMove="OnMove" MouseLeftButtonUp="OnUp"
                 ToolTip="学习通悬浮球"/>
        <TextBlock x:Name="BallText" Text="学" Foreground="White" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
